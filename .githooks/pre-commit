#!/usr/bin/env bash
# Blocks a commit if staged changes contain what looks like a live secret.
# Defense in depth on top of .gitignore -- CLAUDE.md (ai-pm-platform) §3
# rule 1, IMPLEMENTATION_PLAN.md task 1.4. Installed via
# `ai-pm-platform`'s `prepare` script (see ai-pm-platform/scripts/install-hooks.mjs).
set -euo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && exit 0

BLOCKED=0

# Secret-shaped filenames that must never be staged, regardless of .gitignore.
while IFS= read -r f; do
  case "$f" in
    *.dev.vars | *.env | *.env.local | *.env.*.local)
      echo "BLOCKED: '$f' looks like a local secrets file and must never be committed." >&2
      BLOCKED=1
      ;;
  esac
done <<<"$STAGED"

# Content patterns for common live-secret shapes: AWS keys, JWTs (Supabase/
# Google-style), generic *_KEY/*_TOKEN/*_SECRET assignments, OpenAI-style
# sk- keys, Cloudflare API tokens.
PATTERN='(AKIA[0-9A-Z]{16})|(eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,})|((API|SECRET|ACCESS)[_-]?(KEY|TOKEN)[[:space:]]*[:=][[:space:]]*[\"'"'"']?[A-Za-z0-9_.-]{16,})|(sk-[A-Za-z0-9]{20,})|(cfut_[A-Za-z0-9]{20,})'

MATCHES=$(git diff --cached -U0 -- $STAGED | grep -E '^\+' | grep -vE '^\+\+\+' | grep -E "$PATTERN" || true)

if [ -n "$MATCHES" ]; then
  echo "BLOCKED: staged changes contain what looks like a live secret:" >&2
  echo "$MATCHES" >&2
  echo "If this is a genuine false positive, remove the offending line from the diff, or get explicit sign-off before overriding." >&2
  BLOCKED=1
fi

exit $BLOCKED
